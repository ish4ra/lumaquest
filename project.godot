[application]
config/name="LumaQuest"
run/main_scene="res://scenes/Main.tscn"

[display]
window/size/width=640
window/size/height=480
window/size/test_width=960
window/size/test_height=720
window/stretch/mode="2d"
window/stretch/aspect="keep"

[rendering]
quality/driver/driver_name="GLES2"
environment/default_clear_color=Color(0.06, 0.07, 0.11, 1)

[input]
move_left={
"deadzone": 0.3,
"events": [ Object(InputEventKey,"physical_scancode":65), Object(InputEventKey,"physical_scancode":16777231), Object(InputEventJoypadButton,"button_index":14) ]
}
move_right={
"deadzone": 0.3,
"events": [ Object(InputEventKey,"physical_scancode":68), Object(InputEventKey,"physical_scancode":16777233), Object(InputEventJoypadButton,"button_index":15) ]
}
jump={
"deadzone": 0.3,
"events": [ Object(InputEventKey,"physical_scancode":32), Object(InputEventJoypadButton,"button_index":0) ]
}
fairy_action={
"deadzone": 0.3,
"events": [ Object(InputEventKey,"physical_scancode":70), Object(InputEventJoypadButton,"button_index":2) ]
}
attack={
"deadzone": 0.3,
"events": [ Object(InputEventKey,"physical_scancode":74), Object(InputEventJoypadButton,"button_index":1) ]
}
